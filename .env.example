# ============================================================
# mini-agent 配置（只对接 DeepSeek）
# 复制本文件为 .env 后填入 key：
#   copy .env.example .env
# ============================================================

# ---- DeepSeek（必填其中一项 key）----
# 两种变量名都认，填任意一个即可
LLM_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here

LLM_MODEL=deepseek-chat
# 可选：自定义网关地址（默认 https://api.deepseek.com/v1）
# LLM_BASE_URL=https://api.deepseek.com/v1

# ---- 生成参数 ----
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_STREAM=true
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---- Agent 循环 ----
MINI_AGENT_MAX_STEPS=8
MINI_AGENT_MAX_TURNS=200
MINI_AGENT_KEEP_TURNS=6
MINI_AGENT_CONTEXT_BUDGET=8000
MINI_AGENT_TOOL_RESULT_CHARS=800
# 同一轮内并行执行多个工具（工具共享 session 状态时建议关）
MINI_AGENT_PARALLEL_TOOLS=false
# 异步工具开关（加分项）
MINI_AGENT_ASYNC_TOOLS=true
# 按需记忆召回（出现"上次/之前"这类词时才翻历史）
MINI_AGENT_MEMORY_RECALL=true
