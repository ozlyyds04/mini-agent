# ---- LLM（必填）----
# 支持 deepseek / glm / openai / qwen / ark；换一家只改这三行
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
# 可选：自定义网关地址（默认按 provider 自动填）
# LLM_BASE_URL=https://api.deepseek.com/v1

# ---- 生成参数 ----
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_STREAM=true
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---- Agent 循环 ----
MINI_AGENT_MAX_STEPS=8
MINI_AGENT_MAX_TURNS=200
MINI_AGENT_KEEP_TURNS=6
MINI_AGENT_CONTEXT_BUDGET=8000
MINI_AGENT_TOOL_RESULT_CHARS=800
# 同一轮内并行执行多个工具（工具共享 session 状态时建议关）
MINI_AGENT_PARALLEL_TOOLS=false
# 异步工具开关（加分项）
MINI_AGENT_ASYNC_TOOLS=true
